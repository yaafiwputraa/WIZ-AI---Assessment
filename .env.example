# Local PostgreSQL container. These demo-only values can be changed before startup.
POSTGRES_DB=tokomate
POSTGRES_USER=tokomate
POSTGRES_PASSWORD=tokomate_dev
POSTGRES_PORT=5432

# Optional: set this to replace local PostgreSQL with another PostgreSQL provider.
# Supabase example (use its session pooler URL and keep sslmode=require):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require

# The API container reaches Ollama running on the Docker host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local demo staff authentication. Replace these values outside a local demo.
JWT_SECRET=tokomate-local-demo-secret-change-before-production
JWT_ACCESS_TOKEN_MINUTES=480
DEMO_AGENT_EMAIL=agent@tokomate.local
DEMO_AGENT_PASSWORD=DemoAgent123!
DEMO_ADMIN_EMAIL=admin@tokomate.local
DEMO_ADMIN_PASSWORD=DemoAdmin123!
DEMO_ORDER_VERIFICATION_CODE=TOKO192
